# /etc/gha-runner/pool.env on the pool host. Every variable pool.sh reads, with its default -
# which is what the OVH VPS (8 vCPU KVM Haswell, 22 GB) runs. Change a value here, then
# `systemctl restart gha-runner-pool`; running jobs keep their container, replacements get the
# new values.
GHA_RUNNER_IMAGE=gha-runner:local
GHA_RUNNER_ORG=design4pro
GHA_RUNNER_GROUP=vps
GHA_RUNNER_TOKEN_FILE=/etc/gha-runner/token
GHA_RUNNER_INTERVAL=60
GHA_RUNNER_NAME_PREFIX=vps
GHA_RUNNER_ARTIFACTS_DIR=/srv/ci-artifacts

GHA_RUNNER_CI_COUNT=2
GHA_RUNNER_CI_LABELS=self-hosted,linux,X64,ci
GHA_RUNNER_CI_CPUS=4
GHA_RUNNER_CI_MEMORY=8g

GHA_RUNNER_GATE_COUNT=1
GHA_RUNNER_GATE_LABELS=self-hosted,linux,X64,gate
GHA_RUNNER_GATE_CPUS=1
GHA_RUNNER_GATE_MEMORY=2g

GHA_RUNNER_AGENT_COUNT=1
GHA_RUNNER_AGENT_LABELS=self-hosted,linux,X64,agent
GHA_RUNNER_AGENT_CPUS=2
GHA_RUNNER_AGENT_MEMORY=4g
