# /etc/gha-runner/pool.env on a Linux pool host. Every variable pool.sh reads is listed here with
# the value the OVH VPS (8 vCPU, 22 GB) runs; unset variables keep pool.sh's Mac defaults.
# Two slots of four, not three of three: the vCPUs are KVM Haswell, about a third of a Mac core,
# and oversubscribing them pushed planned.travel's e2e shards past their 900 s budget.
GHA_RUNNER_ORG=design4pro
GHA_RUNNER_GROUP=vps
GHA_RUNNER_TOKEN_FILE=/etc/gha-runner/token
GHA_RUNNER_INTERVAL=60
GHA_RUNNER_NAME_PREFIX=vps
GHA_RUNNER_CI_LABELS=self-hosted,linux,X64,ci
GHA_RUNNER_CI_COUNT=2
GHA_RUNNER_CI_CPUS=4
GHA_RUNNER_CI_MEMORY=8g
GHA_RUNNER_AGENT_COUNT=0
GHA_RUNNER_ARTIFACTS_DIR=/srv/ci-artifacts

GHA_RUNNER_CI_COUNT=2
GHA_RUNNER_CI_LABELS=self-hosted,linux,X64,ci
GHA_RUNNER_CI_CPUS=4
GHA_RUNNER_CI_MEMORY=8g

GHA_RUNNER_AGENT_COUNT=1
GHA_RUNNER_AGENT_LABELS=self-hosted,linux,X64,agent
GHA_RUNNER_AGENT_CPUS=2
GHA_RUNNER_AGENT_MEMORY=4g
