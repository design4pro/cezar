{
  "version": 1,
  "baseBranch": "design4pro",
  "tracker": "github",
  "browser": {
    "provider": "agent-browser"
  },
  "validation": {
    "commands": [
      "npm run typecheck",
      "npm test",
      "npm run test:unit",
      "npm run build",
      "npm run test:package"
    ]
  },
  "labels": {
    "enabled": true,
    "pipeline": [
      "review",
      "changes-requested",
      "qa",
      "qa-failed",
      "merge-queue",
      "blocked",
      "do-not-merge"
    ],
    "category": [
      "bug",
      "feature",
      "refactor",
      "security",
      "dependencies",
      "documentation"
    ],
    "meta": [
      "needs-qa",
      "skip-qa",
      "qa-approved",
      "qa-self-verified",
      "in-progress",
      "ci-monitoring"
    ],
    "priority": [
      "priority-low",
      "priority-medium",
      "priority-high",
      "priority-extreme"
    ],
    "risk": [
      "risk-low",
      "risk-medium",
      "risk-high"
    ],
    "intake": [
      "needs-triage",
      "needs-info",
      "ready-for-agent",
      "ready-for-human"
    ],
    "command": [],
    "outside": [
      "do-not-close"
    ]
  },
  "qaGate": true,
  "paths": {
    "runs": ".ai/runs",
    "analysis": ".ai/analysis",
    "specs": ".ai/specs",
    "scripts": ".ai/scripts",
    "qa": ".ai/qa"
  },
  "reviewChecklist": "CODE_REVIEW.md"
}
